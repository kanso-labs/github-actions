{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "{{{datasource}}}",
      "description": "Tool versions pinned as a composite action input default, annotated above the default",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "managerFilePatterns": ["/^actions/.+/action\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+default: (?<currentValue>\\S+)"
      ]
    }
  ],
  "extends": ["config:recommended"],
  "minimumReleaseAge": null,
  "packageRules": [
    {
      "description": "Renovate's own config:recommended sets semanticCommitType through a packageRule, and packageRules beat top-level config. Setting it at the top level therefore does nothing at all: every upgrade stays chore and cuts no release.",
      "matchPackageNames": ["*"],
      "semanticCommitType": "deps"
    },
    {
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch"]
    }
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "rebaseWhen": "behind-base-branch",
  "recreateWhen": "always",
  "semanticCommitScope": null,
  "semanticCommits": "enabled"
}
